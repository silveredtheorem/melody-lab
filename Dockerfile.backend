FROM node:22-alpine

WORKDIR /app

# Copy root workspace files
COPY package.json package-lock.json ./

# Copy shared package
COPY shared/package.json ./shared/
COPY shared/src ./shared/src
COPY shared/tsconfig.json ./shared/

# Copy backend package
COPY backend/package.json ./backend/
COPY backend/prisma ./backend/prisma
COPY backend/prisma.config.ts ./backend/
COPY backend/src ./backend/src
COPY backend/tsconfig.json ./backend/

# Create stub dirs for other workspaces so npm install doesn't fail
RUN mkdir -p frontend worker
COPY frontend/package.json ./frontend/
COPY worker/package.json ./worker/

# Install all workspace dependencies
RUN npm install --workspace=shared --workspace=backend

# Generate Prisma client (needed for tsc to resolve types)
# Use --schema directly to avoid requiring DATABASE_URL from prisma.config.ts during build
WORKDIR /app/backend
RUN npx prisma generate --schema=prisma/schema.prisma

# Build shared then backend
RUN npm run build

EXPOSE 3000
CMD ["npm", "start"]
